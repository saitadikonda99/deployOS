# Copy to .env and adjust as needed. Environment variables always take
# precedence over config.yaml. See docs/device-registration.md for how
# the agent/server/Supabase variables below fit together.

# environment: development | production
DEPLOYOS_ENVIRONMENT=development

# log_level: debug | info | warn | error
DEPLOYOS_LOG_LEVEL=info

# --- Agent (cmd/agent) ---

# Address the node agent's HTTP server listens on.
DEPLOYOS_AGENT_HTTP_ADDR=:8081

# Where the agent persists its device ID and device token across
# restarts. Defaults to "<home>/.deployos" if unset.
DEPLOYOS_AGENT_DATA_DIR=

# The DeployOS control plane's base URL. The agent only ever talks to
# this API - never to Supabase directly.
DEPLOYOS_AGENT_API_BASE_URL=http://localhost:8080

# The control plane's gRPC address, for the agent's persistent
# connection - see docs/connection.md.
DEPLOYOS_AGENT_GRPC_SERVER_ADDR=localhost:9090

# The operator's Supabase user access token, used to authenticate device
# registration requests. Obtained out-of-band (e.g. from Supabase Studio
# or the Supabase client) until a proper login flow exists - see
# docs/device-registration.md.
DEPLOYOS_AGENT_USER_ACCESS_TOKEN=

# Path to the Docker daemon's unix socket, used by the
# LIST_CONTAINERS/INSPECT_CONTAINER commands - see docs/runtime.md.
# Defaults to "/var/run/docker.sock" if unset.
DEPLOYOS_AGENT_DOCKER_SOCKET=

# --- Server / control plane (cmd/server) ---

# Address the control plane's HTTP server listens on.
DEPLOYOS_SERVER_HTTP_ADDR=:8080

# Address the control plane's gRPC server listens on, for the
# persistent agent connection - see docs/connection.md.
DEPLOYOS_SERVER_GRPC_ADDR=:9090

# --- Supabase (required by cmd/server only; the agent never sets these) ---

# Your Supabase project URL, e.g. https://xyz.supabase.co
DEPLOYOS_SUPABASE_URL=

# Your Supabase project's anon/public API key, used to verify user
# access tokens against Supabase Auth.
DEPLOYOS_SUPABASE_ANON_KEY=

# Postgres connection string for your Supabase project's database
# (Project Settings -> Database -> Connection string).
DEPLOYOS_SUPABASE_DATABASE_URL=

# --- Device tokens issued by the control plane on registration ---

# Signs issued device tokens (HMAC). Required in production - generate
# with e.g. `openssl rand -hex 32`.
DEPLOYOS_DEVICE_TOKEN_SECRET=

# How long an issued device token remains valid. Defaults to "8760h"
# (1 year) if unset.
DEPLOYOS_DEVICE_TOKEN_TTL=
