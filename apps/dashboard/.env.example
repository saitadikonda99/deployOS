# Copy to .env.local. Both variables are server-only (never prefixed
# with NEXT_PUBLIC_, so they're never sent to the browser).
#
# See ../../docs/device-registration.md for why DEPLOYOS_API_TOKEN is a
# static token today rather than a per-user session: the dashboard
# doesn't have a real login flow yet.

# Base URL of the DeployOS control plane (cmd/server).
DEPLOYOS_API_URL=http://localhost:8080

# A Supabase user access token, used as-is to authenticate every request
# this dashboard instance makes to the control plane.
DEPLOYOS_API_TOKEN=
